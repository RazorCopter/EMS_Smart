# ==============================================================================
# Afore EMS Companion - Environment Configuration Template
# Copy to .env and fill in real credentials. NEVER commit .env to Git.
# ==============================================================================

# Timezone & Locale
TZ=Europe/Rome
COMPANION_TIMEZONE=Europe/Rome
COMPANION_LOCALE=it-IT
COMPANION_VERSION=0.1.0

# Reverse Proxy & Ports
COMPANION_HTTP_PORT=8080

# PostgreSQL + TimescaleDB
POSTGRES_DB=afore_companion
POSTGRES_USER=afore_companion
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql+asyncpg://afore_companion:change_me_postgres_password@postgres-timescaledb:5432/afore_companion

# Authentication & Security (Viewer + Admin, READ-ONLY Companion)
COMPANION_SECRET_KEY=change_me_to_a_long_random_64_char_secret_key
COMPANION_SESSION_TTL_HOURS=24
COMPANION_COOKIE_SECURE=false
COMPANION_ADMIN_USER=admin
COMPANION_ADMIN_PASSWORD=change_me_admin_password
COMPANION_VIEWER_USER=viewer
COMPANION_VIEWER_PASSWORD=change_me_viewer_password

# MQTT Broker (Read-only telemetry/decision/input ingestion)
MQTT_ENABLED=true
MQTT_HOST=10.0.10.10
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=afore-ems-companion
MQTT_BASE_TOPIC=afore/afore-ems/v1
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_SEM_TOPIC_PREFIX=afore/afore-ems/v1/sem

# ESP32 REST API (Read-only bootstrap, backfill & diagnostics only)
ESP32_ENABLED=true
ESP32_URL=http://10.0.0.110
ESP32_USERNAME=admin
ESP32_PASSWORD=
ESP32_POLL_HEALTH_S=30
ESP32_BACKFILL_INTERVAL_S=60

# Optional Home Assistant Read-Only REST Fallback (prefer MQTT SEM topics)
HA_REST_ENABLED=false
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Retention & Compression Policies (Days)
RETENTION_RAW_MQTT_DAYS=30
RETENTION_TELEMETRY_DAYS=90
RETENTION_AGG_1M_DAYS=730
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 3 * * *

# Comparison & Analytics Defaults
SEM_CONCORDANCE_WATT_THRESHOLD=100
POWER_DEADBAND_W=20
BATTERY_CAPACITY_WH=10240
BATTERY_NOMINAL_V=51.2
