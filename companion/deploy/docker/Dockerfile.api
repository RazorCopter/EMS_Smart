FROM python:3.12-slim AS builder

WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip build wheel

COPY packages/energy-domain ./packages/energy-domain
COPY database ./database
COPY apps/api ./apps/api

RUN pip wheel --no-cache-dir --wheel-dir /wheels \
    ./packages/energy-domain \
    ./database \
    ./apps/api

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd -r companion && useradd -r -g companion companion
WORKDIR /app

COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels

COPY database/alembic.ini ./database/alembic.ini
COPY database/migrations ./database/migrations

RUN install -d -o companion -g companion /var/lib/companion/esp-logs

USER companion
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"

# Run idempotent schema migrations before starting uvicorn so no stopped init container remains in Portainer
CMD ["sh", "-c", "cd /app/database && alembic upgrade head && cd /app && exec uvicorn companion_api.main:app --host 0.0.0.0 --port 8000 --proxy-headers"]
