FROM python:3.12-slim AS builder

WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip wheel

COPY packages/energy-domain ./packages/energy-domain
COPY database ./database
COPY apps/collector ./apps/collector

RUN pip wheel --no-cache-dir --wheel-dir /wheels \
    ./packages/energy-domain \
    ./database \
    ./apps/collector

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd -r companion && useradd -r -g companion companion
WORKDIR /app

COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels

USER companion
EXPOSE 9101

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9101/healthz', timeout=3)"

CMD ["python", "-m", "companion_collector.main"]
