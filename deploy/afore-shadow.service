[Unit]
Description=Afore Autonomous EMS (Shadow Read-Only Daemon + Web GUI)
Documentation=https://github.com/RazorCopter/EMS_Smart
After=network.target

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/opt/afore-ems
ExecStart=/usr/bin/python3 /opt/afore-ems/web_ui.py --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
