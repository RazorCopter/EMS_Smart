  "homeassistant/select/afore-ems_select_strategy/config": {
    "name": "Local strategy",
    "unique_id": "afore-ems_select_strategy",
    "device": {
      "identifiers": [
        "afore-ems"
      ],
      "name": "Afore Autonomous EMS"
    },
    "availability_topic": "afore/afore-ems/v1/availability",
    "state_topic": "afore/afore-ems/v1/config/state",
    "value_template": "{{ value_json.strategy_name }}",
    "options": [
      "SELF_USE",
      "CHARGE_FIRST",
      "NATIVE_INVERTER",
      "SAFE_MODE",
      "TARGET_SOC",
      "MAINTENANCE"
    ],
    "command_topic": "afore/afore-ems/v1/ems/command",
    "command_template": "{\"schema\":1,\"message_id\":\"afore-ems_select_strategy-{{ (now().timestamp()*1000000)|int }}\",\"timestamp\":{{ now().timestamp()|int }},\"ttl\":30,\"action\":\"policy\",\"payload\":{\"strategy\":{{ ['SELF_USE','CHARGE_FIRST','NATIVE_INVERTER','SAFE_MODE','TARGET_SOC','MAINTENANCE'].index(value) }}}}"
  },
