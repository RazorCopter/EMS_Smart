{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Home Assistant MQTT Discovery Payloads for Afore AF5K-SL Shadow Mode",
    "description": "Auto-discovery sensor definitions published by Heliograph firmware in read-only shadow monitoring mode.",
    "entities": [
        {
            "component": "sensor",
            "object_id": "afore_v4_battery_soc",
            "discovery_topic": "homeassistant/sensor/afore_v4/battery_soc/config",
            "payload": {
                "name": "Battery SoC",
                "unique_id": "afore_v4_battery_soc",
                "state_topic": "heliograph/afore_shadow/telemetry",
                "value_template": "{{ value_json.battery_soc }}",
                "unit_of_measurement": "%",
                "device_class": "battery",
                "state_class": "measurement",
                "availability_topic": "heliograph/afore_shadow/status",
                "payload_available": "online",
                "payload_not_available": "offline",
                "json_attributes_topic": "heliograph/afore_shadow/telemetry",
                "json_attributes_template": "{{ {'quality': value_json.quality_battery_soc, 'age_ms': value_json.age_battery_soc_ms} | tojson }}",
                "device": {
                    "identifiers": [
                        "heliograph_afore_v4"
                    ],
                    "name": "Afore AF5K-SL Inverter",
                    "model": "AF5K-SL (Shadow Mode)",
                    "manufacturer": "Afore",
                    "sw_version": "1.0.0-shadow-g2"
                }
            }
        },
        {
